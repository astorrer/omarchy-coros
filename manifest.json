{
  "schemaVersion": 1,
  "id": "io.github.astorrer.omarchy-coros",
  "name": "Omarchy-coros",
  "version": "0.1.0",
  "author": "Aaron Storrer",
  "license": "MIT",
  "description": "COROS recovery metrics on the Omarchy bar. Shows HRV vs baseline, resting heart rate, training load, and the last activity from your COROS Training Hub account.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "COROS",
    "description": "COROS recovery metrics: HRV, resting heart rate, training load, and last activity.",
    "category": "Health",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMin": 30,
      "region": "eu",
      "hideWhenNoData": false,
      "showRecovery": true,
      "showLoad": true,
      "showActivity": true,
      "barMetric": "hrv"
    },
    "schema": [
      {
        "key": "refreshIntervalMin",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 15,
        "max": 1440,
        "step": 15,
        "defaultValue": 30
      },
      {
        "key": "region",
        "type": "string",
        "label": "COROS region (eu or us)",
        "defaultValue": "eu"
      },
      {
        "key": "hideWhenNoData",
        "type": "boolean",
        "label": "Hide when no data available",
        "defaultValue": false
      },
      {
        "key": "showRecovery",
        "type": "boolean",
        "label": "Show overnight recovery",
        "defaultValue": true
      },
      {
        "key": "showLoad",
        "type": "boolean",
        "label": "Show training load",
        "defaultValue": true
      },
      {
        "key": "showActivity",
        "type": "boolean",
        "label": "Show last activity",
        "defaultValue": true
      },
      {
        "key": "barMetric",
        "type": "string",
        "label": "Bar display (icon, hrv, rhr, load, or fatigue)",
        "defaultValue": "hrv"
      }
    ]
  }
}
